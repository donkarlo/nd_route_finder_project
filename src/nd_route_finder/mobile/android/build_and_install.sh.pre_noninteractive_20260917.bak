#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

GARMIN_BRIDGE="$ROOT/app/src/main/java/com/ndroutefinder/mobile/GarminBridge.java"

if [[ -f "$GARMIN_BRIDGE" ]]; then
  python3 - "$GARMIN_BRIDGE" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

old = '        } catch (InvalidStateException e) {\n            emit("Garmin GPS listener unavailable: " + message(e));\n'
new = '        } catch (InvalidStateException | ServiceUnavailableException e) {\n            emit("Garmin GPS listener unavailable: " + message(e));\n'

if old in text:
    path.write_text(text.replace(old, new, 1), encoding="utf-8")
    print("Applied Garmin registerForAppEvents exception fix.")
elif new in text:
    print("Garmin registerForAppEvents exception fix already present.")
else:
    print("Warning: GarminBridge exception block did not match expected text.", file=sys.stderr)
PY
fi

SDK_DIR="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$HOME/Android/Sdk}}"
if [[ ! -f local.properties && -d "$SDK_DIR" ]]; then
  printf 'sdk.dir=%s\n' "$SDK_DIR" > local.properties
fi

if [[ -x "$ROOT/gradlew" ]]; then
  GRADLE=("$ROOT/gradlew")
elif [[ -x "/home/donkarlo/Dropbox/repo/nd_planning_project/src/nd_planning/mobile/android/gradlew" ]]; then
  GRADLE=("/home/donkarlo/Dropbox/repo/nd_planning_project/src/nd_planning/mobile/android/gradlew" -p "$ROOT")
elif command -v gradle >/dev/null 2>&1; then
  GRADLE=(gradle -p "$ROOT")
else
  echo "No Gradle wrapper/system Gradle found." >&2
  exit 2
fi

"${GRADLE[@]}" :app:assembleDebug
APK="$ROOT/app/build/outputs/apk/debug/app-debug.apk"
echo "Built: $APK"

ADB="$SDK_DIR/platform-tools/adb"
if [[ ! -x "$ADB" ]]; then
  echo "adb not found at: $ADB"
  echo "APK was built but not installed."
  exit 0
fi

"$ADB" start-server >/dev/null

list_devices() {
  "$ADB" devices | awk 'NR>1 && $2=="device" {print $1}'
}

install_if_connected() {
  mapfile -t DEVICES < <(list_devices)

  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    "$ADB" -s "$ANDROID_SERIAL" install -r "$APK"
    return 0
  fi

  if (( ${#DEVICES[@]} == 1 )); then
    echo "Installing to ${DEVICES[0]} ..."
    "$ADB" -s "${DEVICES[0]}" install -r "$APK"
    return 0
  fi

  if (( ${#DEVICES[@]} > 1 )); then
    echo "More than one adb device is connected."
    echo "Choose one with:"
    echo "  $ADB devices -l"
    echo "Then run:"
    echo "  ANDROID_SERIAL='<serial>' bash build_and_install.sh"
    return 2
  fi

  return 1
}

try_wireless_connect() {
  local attempt endpoint
  for attempt in 1 2 3; do
    mapfile -t ENDPOINTS < <(
      "$ADB" mdns services 2>/dev/null |
        awk '$2=="_adb-tls-connect._tcp" && $3 ~ /^[0-9A-Fa-f:.]+:[0-9]+$/ {print $3}' |
        awk '!seen[$0]++'
    )

    if (( ${#ENDPOINTS[@]} == 0 )); then
      sleep 1
      continue
    fi

    for endpoint in "${ENDPOINTS[@]}"; do
      echo "Trying wireless adb: $endpoint"
      "$ADB" connect "$endpoint" || true
      sleep 1
      if list_devices | grep -Fxq "$endpoint"; then
        echo "Wireless adb connected: $endpoint"
        return 0
      fi
    done

    sleep 1
  done
  return 1
}

if install_if_connected; then
  exit 0
else
  status=$?
  (( status == 2 )) && exit 0
fi

echo "No adb device is connected. Looking for a paired Wireless debugging device..."

if try_wireless_connect; then
  install_if_connected
  exit $?
fi

echo
echo "Could not auto-connect to a paired Wireless debugging device."
echo "If the phone is already paired, keep Wireless debugging ON and run this script again."
echo
echo "If pairing was lost, this script can pair it now."
if [[ -t 0 ]]; then
  read -r -p "Pair now? [y/N] " answer
  case "$answer" in
    y|Y|yes|YES)
      echo "On the phone open: Developer options > Wireless debugging > Pair device with pairing code"
      read -r -p "Pairing IP:port shown on the phone: " pair_addr
      read -r -p "6-digit pairing code: " pair_code

      if [[ ! "$pair_addr" =~ ^[0-9A-Fa-f:.]+:[0-9]+$ ]]; then
        echo "Invalid pairing address: $pair_addr" >&2
        exit 3
      fi
      if [[ ! "$pair_code" =~ ^[0-9]{6}$ ]]; then
        echo "Invalid pairing code." >&2
        exit 3
      fi

      "$ADB" pair "$pair_addr" "$pair_code"

      echo "Pairing completed. Waiting for the normal Wireless debugging endpoint..."
      sleep 2
      if try_wireless_connect; then
        install_if_connected
        exit $?
      fi

      echo "Paired, but could not connect automatically yet."
      echo "Keep Wireless debugging ON and run:"
      echo "  bash build_and_install.sh"
      exit 4
      ;;
  esac
fi

echo "APK is ready at: $APK"
exit 0
