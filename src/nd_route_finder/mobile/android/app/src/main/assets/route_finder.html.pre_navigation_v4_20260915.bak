<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=yes" />
<title>ND Route Finder</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
:root{--bg:#f6f8fb;--panel:#fff;--ink:#172033;--muted:#667085;--line:#dbe2ea;--accent:#2463a7;--green:#218b50;--red:#c84343;--soft:#eef4fb;--purple:#7c3aed;--shadow:0 6px 24px rgba(26,39,61,.10)}
*{box-sizing:border-box}html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink)}
body{overflow:hidden}.app{height:100%;display:grid;grid-template-columns:minmax(340px,420px) 1fr}.panel{background:var(--panel);border-right:1px solid var(--line);overflow:auto;padding:12px 14px 22px;z-index:1000}.mapWrap{position:relative;min-width:0;touch-action:none}.map{height:100%;width:100%;background:#e8edf3;touch-action:none}
h1{font-size:20px;margin:0 0 8px;display:flex;align-items:center;gap:8px}.logo{width:29px;height:29px;border-radius:8px}.pill{display:inline-block;font-size:10px;padding:3px 7px;border-radius:99px;background:var(--soft);color:var(--accent);margin-left:auto}
.modeTabs{display:grid;grid-template-columns:1fr 1fr;gap:7px;position:sticky;top:0;background:#fff;padding:3px 0 8px;z-index:1100}.modeTabs button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.section{border:1px solid var(--line);border-radius:12px;margin-top:9px;padding:10px;background:#fff}.sectionTitle{font-weight:750;font-size:14px;margin-bottom:7px}.row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.field{margin-top:7px}.field label{display:block;font-size:12px;color:var(--muted);font-weight:650;margin-bottom:4px}input,select,button{font:inherit}input,select{width:100%;min-height:40px;border:1px solid #cbd5df;border-radius:9px;padding:8px 9px;background:#fff;color:var(--ink)}button{min-height:40px;border:0;border-radius:9px;padding:8px 10px;font-weight:700;background:var(--accent);color:#fff;cursor:pointer}button.secondary{background:#eef2f7;color:#24344e;border:1px solid #cfd7e1}button.green{background:var(--green)}button.purple{background:var(--purple)}button:disabled{opacity:.55;cursor:default}.buttonGrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.buttonStack{display:grid;gap:7px;margin-top:8px}.searchResults{margin-top:6px;display:grid;gap:5px}.searchItem{display:block;text-align:left;width:100%;background:#f7f9fc;color:#263449;border:1px solid var(--line);font-weight:500;line-height:1.25;min-height:42px}.searchDistance{font-size:10px;color:var(--muted);margin-top:2px}.waypoints{display:grid;gap:6px;margin-top:7px}.wp{border:1px solid var(--line);border-radius:9px;padding:7px;background:#f8fafc;display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center}.wpText{font-size:12px;line-height:1.25;overflow-wrap:anywhere}.wpBtns{display:flex;gap:4px}.mini{min-width:31px;min-height:30px;padding:4px 7px;border-radius:7px;background:#e9eef5;color:#22334d}.status{font-size:12px;line-height:1.4;color:#344258;background:#f4f7fb;border-radius:9px;padding:8px;margin-top:7px;white-space:pre-wrap}.garminStatus{background:#f2f8f5;border:1px solid #cfe8da}.hint{font-size:11px;color:var(--muted);line-height:1.35;margin-top:5px}.routeStats{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.stat{font-size:11px;background:#edf3f9;padding:5px 7px;border-radius:99px}
.profileGrid{display:grid;gap:9px}.profileCard{border:1px solid var(--line);border-radius:9px;padding:7px;background:#fbfcfe}.profileTitle{font-size:12px;font-weight:700;margin-bottom:4px}.profileSvg{display:block;width:100%;height:96px;background:#fff;border-radius:6px}.profileMeta{font-size:10px;color:var(--muted);margin-top:3px}
.legend{position:absolute;top:10px;right:10px;z-index:500;background:rgba(255,255,255,.95);border:1px solid #d5dce5;border-radius:10px;padding:8px 9px;box-shadow:var(--shadow);font-size:11px;max-width:180px}.slopeBar{height:7px;border-radius:5px;background:linear-gradient(90deg,hsl(120 80% 37%),hsl(80 85% 42%),hsl(50 90% 48%),hsl(25 90% 50%),hsl(0 85% 48%));margin:5px 0 3px}.legendScale{display:flex;justify-content:space-between;color:#59667a;font-size:9px}.liveBadge{position:absolute;left:10px;bottom:12px;z-index:520;background:rgba(255,255,255,.95);border:1px solid #d5dce5;border-radius:10px;padding:7px 9px;box-shadow:var(--shadow);font-size:11px;max-width:240px}.recenter{position:absolute;right:10px;bottom:12px;z-index:530;min-width:44px;width:44px;height:44px;border-radius:50%;padding:0;font-size:21px;box-shadow:var(--shadow)}
.ndPositionIcon{background:transparent!important;border:0!important}.positionArrow{width:34px;height:34px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 2px 2px rgba(0,0,0,.35))}.positionArrowInner{width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-bottom:27px solid #1769d2;transform-origin:50% 60%;position:relative}.positionArrowInner:after{content:"";position:absolute;left:-4px;top:18px;width:8px;height:8px;background:#fff;border-radius:50%}
.navOnly{display:none}.plannerOnly{display:block}.mapOnlyButton{display:none}.mapFocused .panel{display:none}.mapFocused .app{grid-template-columns:1fr}.mapFocused .mapOnlyButton{display:block;position:absolute;top:10px;left:10px;z-index:800;box-shadow:var(--shadow)}
@media(max-width:800px){body{overflow:auto}.app{height:auto;min-height:100%;display:block}.panel{border-right:0;border-bottom:1px solid var(--line);max-height:none;padding-bottom:12px}.mapWrap{height:61vh;min-height:430px}.map{height:100%}.legend{top:8px;right:8px}.section{padding:9px}.row{gap:6px}.mapFocusButton{display:block!important}.mapFocused{overflow:hidden}.mapFocused .mapWrap{height:100vh;min-height:100vh}.mapFocused .mapOnlyButton{display:block}.liveBadge{max-width:65vw}.modeTabs{top:0}}
</style>
</head>
<body>
<div class="app">
  <aside class="panel" id="panel">
    <h1><img class="logo" src="app_icon.svg" alt="">ND Route Finder <span class="pill">mobile v3</span></h1>
    <div class="modeTabs">
      <button id="tabPlanner" class="secondary active" onclick="setMode('planner')">Plan route</button>
      <button id="tabNavigate" class="secondary" onclick="setMode('navigate')">Navigate GPX</button>
    </div>

    <div id="plannerPane" class="plannerOnly">
      <div class="section">
        <div class="sectionTitle">Map / nearby search</div>
        <input id="plannerSearch" placeholder="Search a place or address" autocomplete="off" />
        <div id="plannerSearchResults" class="searchResults"></div>
        <div class="field"><label>Search/map action</label><select id="selectionMode"><option value="start">Set start point</option><option value="waypoint">Add intermediate point</option></select></div>
      </div>

      <div class="section">
        <div class="sectionTitle">Route settings</div>
        <div class="field"><label>Activity</label><select id="activity"><option value="cycling">Cycling</option><option value="hiking">Hiking</option><option value="walking">Walking — paths allowed</option></select></div>
        <div class="row"><div class="field"><label>Start latitude</label><input id="lat" type="number" step="0.0000001" value="47.0707000" /></div><div class="field"><label>Start longitude</label><input id="lon" type="number" step="0.0000001" value="15.4395000" /></div></div>
        <div class="row"><div class="field"><label>Target distance (km)</label><input id="distance" type="number" min="1" max="150" step="0.5" value="20" /></div><div class="field"><label>Maximum slope (%)</label><input id="grade" type="number" min="1" max="60" step="0.5" value="12" /></div></div>
        <div class="hint">Cycling uses BRouter trekking; walking/hiking use a path-capable hiking profile.</div>
      </div>

      <div class="section"><div class="sectionTitle">Intermediate points</div><div id="waypoints" class="waypoints"></div><div class="buttonGrid"><button class="secondary" onclick="clearWaypoints()">Clear</button><button class="secondary" onclick="fitVisible()">Fit map</button></div></div>
      <div class="section"><div class="sectionTitle">Route</div><div class="buttonGrid"><button id="generateBtn" onclick="generateRoute()">Generate route</button><button class="secondary" onclick="Android.pickGpx()">Load GPX</button></div><div id="routeStats" class="routeStats"></div><div id="status" class="status">Tap the map to choose the start point.</div></div>

      <div class="section" id="profilesSection" style="display:none"><div class="sectionTitle">Route profiles</div><div class="profileGrid"><div class="profileCard"><div class="profileTitle">Elevation profile</div><svg id="elevationProfile" class="profileSvg" viewBox="0 0 360 96" preserveAspectRatio="none"></svg><div id="elevationMeta" class="profileMeta"></div></div><div class="profileCard"><div class="profileTitle">Slope profile</div><svg id="slopeProfile" class="profileSvg" viewBox="0 0 360 96" preserveAspectRatio="none"></svg><div id="slopeMeta" class="profileMeta"></div></div></div></div>

      <div class="section"><div class="sectionTitle">Garmin</div><div class="buttonStack"><button class="green" onclick="sendToCurrentActivity()">Navigate active Garmin activity to start point</button><button class="green" onclick="openNativeNavigation()">Open Garmin navigation for start point</button><button class="green" onclick="sendRoute()">Send current GPX route to Garmin Connect</button><button class="secondary" onclick="Android.refreshGarmin()">Refresh Garmin connection</button></div><div id="garminStatus" class="status garminStatus">Garmin: initializing…</div></div>
    </div>

    <div id="navigatePane" class="navOnly">
      <div class="section">
        <div class="sectionTitle">GPX navigation</div>
        <div class="buttonGrid"><button onclick="Android.pickGpx()">Load GPX</button><button class="secondary mapFocusButton" style="display:none" onclick="focusMap(true)">Full map</button></div>
        <div id="loadedRouteStatus" class="status">Load a GPX route, or add a destination without a GPX.</div>
      </div>

      <div class="section">
        <div class="sectionTitle">Live position</div>
        <div class="row"><div class="field"><label>GPS source</label><select id="gpsSource" onchange="changeGpsSource()"><option value="phone">Mobile phone GPS</option><option value="garmin">Garmin Fenix 8 GPS</option></select></div><div class="field"><label>Routing</label><select id="navActivity"><option value="cycling">Cycling</option><option value="walking">Walking</option></select></div></div>
        <div class="buttonGrid"><button class="secondary" onclick="recenter()">Follow / recenter</button><button class="secondary" onclick="Android.requestCurrentPosition()">Refresh GPS</button></div>
        <div id="positionStatus" class="status">Waiting for phone position…</div>
        <div class="hint">Fenix GPS requires an active activity containing the updated “ND Route Target” data field.</div>
      </div>

      <div class="section">
        <div class="sectionTitle">Add a stop nearby</div>
        <input id="navSearch" placeholder="Search near current position" autocomplete="off" />
        <div id="navSearchResults" class="searchResults"></div>
        <div class="hint">Results are sorted by distance from the currently selected GPS source.</div>
      </div>

      <div class="section"><div class="sectionTitle">New route points</div><div id="navStops" class="waypoints"></div><div class="buttonGrid"><button class="secondary" onclick="clearNavStops()">Clear points</button><button class="secondary" onclick="fitVisible()">Fit map</button></div></div>

      <div class="section">
        <div class="sectionTitle">Route from here</div>
        <button id="navRouteBtn" style="width:100%" class="purple" onclick="buildNavigationRoute()">Shortest practical route from current position</button>
        <div id="navRouteStats" class="routeStats"></div>
        <div id="navStatus" class="status">Add one or more points. With a loaded GPX, the route will rejoin it ahead of you.</div>
      </div>
    </div>
  </aside>

  <main class="mapWrap" id="mapWrap">
    <div id="map" class="map"></div>
    <button class="secondary mapOnlyButton" onclick="focusMap(false)">Controls</button>
    <div class="legend"><b>Slope</b><div class="slopeBar"></div><div class="legendScale"><span>0%</span><span>5%</span><span>10%</span><span>15%+</span></div><div id="legendNote" class="hint" style="margin-top:4px">Green = low slope, red = steep.</div></div>
    <div id="liveBadge" class="liveBadge">GPS: waiting…</div>
    <button class="recenter" onclick="recenter()" title="Follow current position">◎</button>
  </main>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
'use strict';
const $=id=>document.getElementById(id);
const start={lat:47.0707,lon:15.4395};
let map,startMarker,plannerWaypointMarkers=[],navStopMarkers=[],rejoinMarker=null;
let waypoints=[],navStops=[],mode='planner',busy=false,navBusy=false;
let mainRouteGroup=null,navRouteGroup=null,baseRoute=null,currentRoute=null;
let currentPosition=null,positionMarker=null,accuracyCircle=null,followPosition=true,programmaticMove=false;
let plannerSearchTimer=null,navSearchTimer=null;

function init(){
  map=L.map('map',{zoomControl:true,touchZoom:true,dragging:true,doubleClickZoom:true,scrollWheelZoom:true,tap:true}).setView([start.lat,start.lon],13);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:20,attribution:'© OpenStreetMap contributors'}).addTo(map);
  startMarker=L.marker([start.lat,start.lon]).addTo(map).bindTooltip('Start');
  map.on('click',e=>{if(mode==='navigate')addNavStop(e.latlng.lat,e.latlng.lng,'Map point');else applyPlannerPoint(e.latlng.lat,e.latlng.lng,'Map point');});
  map.on('dragstart',()=>{followPosition=false;});
  $('lat').addEventListener('change',syncStartInputs);$('lon').addEventListener('change',syncStartInputs);
  bindAutoSearch('plannerSearch','planner',()=>currentPosition||{lat:start.lat,lon:start.lon},()=>plannerSearchTimer,v=>plannerSearchTimer=v);
  bindAutoSearch('navSearch','nav',()=>currentPosition||{lat:start.lat,lon:start.lon},()=>navSearchTimer,v=>navSearchTimer=v);
  renderWaypoints();renderNavStops();Android.requestCurrentPosition();
}
function n(v,f=0){const x=Number(v);return Number.isFinite(x)?x:f;}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function validLatLon(lat,lon){return Number.isFinite(lat)&&Number.isFinite(lon)&&lat>=-90&&lat<=90&&lon>=-180&&lon<=180;}
function hav(a,b){const R=6371008.8,rad=Math.PI/180;const p1=a[0]*rad,p2=b[0]*rad,dp=(b[0]-a[0])*rad,dl=(b[1]-a[1])*rad;const x=Math.sin(dp/2)**2+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)**2;return 2*R*Math.asin(Math.min(1,Math.sqrt(x)));}
function distanceText(m){if(!Number.isFinite(Number(m)))return '';m=Number(m);return m<1000?`${Math.round(m)} m`:`${(m/1000).toFixed(m<10000?1:0)} km`;}

function setMode(next){mode=next==='navigate'?'navigate':'planner';$('plannerPane').style.display=mode==='planner'?'block':'none';$('navigatePane').style.display=mode==='navigate'?'block':'none';$('tabPlanner').classList.toggle('active',mode==='planner');$('tabNavigate').classList.toggle('active',mode==='navigate');setTimeout(()=>map.invalidateSize(),80);}
function focusMap(on){document.body.classList.toggle('mapFocused',!!on);setTimeout(()=>{map.invalidateSize();if(on)fitVisible();},120);}
function syncStartInputs(){setStart(n($('lat').value,start.lat),n($('lon').value,start.lon),'Coordinates');}
function setStart(lat,lon,label){if(!validLatLon(lat,lon))return;start.lat=lat;start.lon=lon;$('lat').value=lat.toFixed(7);$('lon').value=lon.toFixed(7);startMarker.setLatLng([lat,lon]).bindTooltip('Start — '+label);if(!busy)$('status').textContent=`Start selected: ${lat.toFixed(6)}, ${lon.toFixed(6)}`;}
function applyPlannerPoint(lat,lon,label){if($('selectionMode').value==='waypoint'){waypoints.push({lat,lon,label});renderWaypoints();syncPlannerMarkers();}else setStart(lat,lon,label);}
function renderWaypoints(){const root=$('waypoints');root.innerHTML='';waypoints.forEach((w,i)=>{const el=document.createElement('div');el.className='wp';el.innerHTML=`<div class="wpText"><b>${i+1}.</b> ${esc(w.label||'Waypoint')}<br>${w.lat.toFixed(6)}, ${w.lon.toFixed(6)}</div><div class="wpBtns"><button class="mini" onclick="moveWp(${i},-1)">↑</button><button class="mini" onclick="moveWp(${i},1)">↓</button><button class="mini" onclick="removeWp(${i})">×</button></div>`;root.appendChild(el);});if(!waypoints.length)root.innerHTML='<div class="hint">No intermediate points.</div>';}
function syncPlannerMarkers(){plannerWaypointMarkers.forEach(m=>map.removeLayer(m));plannerWaypointMarkers=[];waypoints.forEach((w,i)=>plannerWaypointMarkers.push(L.circleMarker([w.lat,w.lon],{radius:7,color:'#8b5cf6',fillColor:'#fff',fillOpacity:1,weight:3}).addTo(map).bindTooltip(`${i+1}. ${w.label||'Waypoint'}`)));}
function moveWp(i,d){const j=i+d;if(j<0||j>=waypoints.length)return;[waypoints[i],waypoints[j]]=[waypoints[j],waypoints[i]];renderWaypoints();syncPlannerMarkers();}
function removeWp(i){waypoints.splice(i,1);renderWaypoints();syncPlannerMarkers();}
function clearWaypoints(){waypoints=[];renderWaypoints();syncPlannerMarkers();}

function addNavStop(lat,lon,label){if(!validLatLon(lat,lon))return;navStops.push({lat,lon,label:label||'Route point'});renderNavStops();syncNavMarkers();$('navStatus').textContent=`Added ${label||'route point'}. Press “Shortest practical route…” to recalculate.`;}
function renderNavStops(){const root=$('navStops');root.innerHTML='';navStops.forEach((w,i)=>{const el=document.createElement('div');el.className='wp';el.innerHTML=`<div class="wpText"><b>${i+1}.</b> ${esc(w.label||'Route point')}<br>${w.lat.toFixed(6)}, ${w.lon.toFixed(6)}</div><div class="wpBtns"><button class="mini" onclick="moveNav(${i},-1)">↑</button><button class="mini" onclick="moveNav(${i},1)">↓</button><button class="mini" onclick="removeNav(${i})">×</button></div>`;root.appendChild(el);});if(!navStops.length)root.innerHTML='<div class="hint">No added points. Search nearby or tap the map.</div>';}
function syncNavMarkers(){navStopMarkers.forEach(m=>map.removeLayer(m));navStopMarkers=[];navStops.forEach((w,i)=>navStopMarkers.push(L.circleMarker([w.lat,w.lon],{radius:8,color:'#7c3aed',fillColor:'#fff',fillOpacity:1,weight:3}).addTo(map).bindTooltip(`${i+1}. ${w.label||'Route point'}`)));}
function moveNav(i,d){const j=i+d;if(j<0||j>=navStops.length)return;[navStops[i],navStops[j]]=[navStops[j],navStops[i]];renderNavStops();syncNavMarkers();}
function removeNav(i){navStops.splice(i,1);renderNavStops();syncNavMarkers();}
function clearNavStops(){navStops=[];renderNavStops();syncNavMarkers();if(rejoinMarker){map.removeLayer(rejoinMarker);rejoinMarker=null;}clearNavRoute();}

function bindAutoSearch(inputId,context,getOrigin,getTimer,setTimer){const input=$(inputId);function run(){const q=input.value.trim();if(q.length<2)return;const o=getOrigin();const root=$(context==='nav'?'navSearchResults':'plannerSearchResults');root.innerHTML='<div class="hint">Searching nearby…</div>';Android.searchPlacesNear(context,q,n(o.lat,NaN),n(o.lon,NaN));}input.addEventListener('input',()=>{const old=getTimer();if(old)clearTimeout(old);if(input.value.trim().length<2)return;setTimer(setTimeout(run,350));});input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();const old=getTimer();if(old)clearTimeout(old);run();}});}
window.ndSearchResults=function(context,results){const nav=context==='nav',root=$(nav?'navSearchResults':'plannerSearchResults');root.innerHTML='';(results||[]).forEach(r=>{const b=document.createElement('button');b.className='searchItem';const d=distanceText(r.distanceM);b.innerHTML=`<div>${esc(r.label)}</div>${d?`<div class="searchDistance">${d} from current position</div>`:''}`;b.onclick=()=>{const lat=Number(r.lat),lon=Number(r.lon);if(nav)addNavStop(lat,lon,r.label);else applyPlannerPoint(lat,lon,r.label);programmaticMove=true;map.setView([lat,lon],16);setTimeout(()=>programmaticMove=false,80);root.innerHTML='';};root.appendChild(b);});if(!results||!results.length)root.innerHTML='<div class="hint">No results.</div>';};
window.ndSearchFailed=function(context,msg){$(context==='nav'?'navSearchResults':'plannerSearchResults').innerHTML='<div class="hint">'+esc(msg)+'</div>';};

function generateRoute(){if(busy)return;const req={startLat:start.lat,startLon:start.lon,activity:$('activity').value,distanceKm:n($('distance').value,20),maxGrade:n($('grade').value,12),waypoints:waypoints.map(w=>({lat:w.lat,lon:w.lon}))};Android.generateRoute(JSON.stringify(req));}
window.ndSetBusy=function(flag,text){busy=!!flag;$('generateBtn').disabled=busy;if(text)$('status').textContent=text;};
window.ndSetNavBusy=function(flag,text){navBusy=!!flag;$('navRouteBtn').disabled=navBusy;if(text)$('navStatus').textContent=text;};

function slopeColor(absGrade){const g=Math.max(0,Math.min(15,Number(absGrade)||0));const hue=120*(1-g/15);return `hsl(${hue.toFixed(0)} 82% 42%)`;}
function routeHasElevation(points){return points.length>1&&points.every(p=>p.length>2&&Number.isFinite(Number(p[2])));}
function drawSlopeRoute(data,opts={}){const pts=(data.points||[]).map(p=>[Number(p[0]),Number(p[1]),p.length>2?Number(p[2]):NaN]).filter(p=>validLatLon(p[0],p[1]));if(pts.length<2)return null;const group=L.layerGroup().addTo(map);const weight=opts.weight||6,opacity=opts.opacity??.96;if(!routeHasElevation(pts)){L.polyline(pts.map(p=>[p[0],p[1]]),{color:opts.fallbackColor||'#2463a7',weight,opacity,lineJoin:'round',lineCap:'round'}).addTo(group);return group;}
  const cum=[0];for(let i=1;i<pts.length;i++)cum[i]=cum[i-1]+hav(pts[i-1],pts[i]);
  let runLevel=null,runPts=[];
  function flush(){if(runPts.length>1){const grade=runLevel*1.5;L.polyline(runPts,{color:slopeColor(grade),weight,opacity,lineJoin:'round',lineCap:'round'}).addTo(group);}runPts=[];}
  for(let i=1;i<pts.length;i++){let j=i-1;while(j>0&&cum[i]-cum[j]<60)j--;const horiz=Math.max(1,cum[i]-cum[j]);const grade=Math.abs(100*(pts[i][2]-pts[j][2])/horiz);const level=Math.min(10,Math.max(0,Math.round(grade/1.5)));const a=[pts[i-1][0],pts[i-1][1]],b=[pts[i][0],pts[i][1]];if(runLevel===null){runLevel=level;runPts=[a,b];}else if(level===runLevel){runPts.push(b);}else{flush();runLevel=level;runPts=[a,b];}}
  flush();return group;
}
function groupBounds(group){if(!group)return null;const bounds=L.latLngBounds([]);group.eachLayer(layer=>{try{const b=layer.getBounds();if(b&&b.isValid())bounds.extend(b);}catch(ignore){}});return bounds.isValid()?bounds:null;}
function removeGroup(group){if(group&&map.hasLayer(group))map.removeLayer(group);}
function drawMainRoute(data){removeGroup(mainRouteGroup);currentRoute=data;mainRouteGroup=drawSlopeRoute(data,{weight:6});if(mainRouteGroup){const b=groupBounds(mainRouteGroup);if(b)fitBoundsSafe(b);}const hasEle=routeHasElevation((data.points||[]).map(p=>[Number(p[0]),Number(p[1]),p.length>2?Number(p[2]):NaN]));$('legendNote').textContent=hasEle?'Green = low slope, red = steep.':'No elevation in this GPX: blue route, slope colors unavailable.';return hasEle;}
function clearNavRoute(){removeGroup(navRouteGroup);navRouteGroup=null;$('navRouteStats').innerHTML='';}
function fitBoundsSafe(bounds){if(!bounds||!bounds.isValid())return;programmaticMove=true;map.invalidateSize({pan:false});map.fitBounds(bounds,{padding:[24,24],animate:false});setTimeout(()=>programmaticMove=false,100);}
function displayRoute(data,loaded){const hasEle=drawMainRoute(data);const slope=data.maxGrade==null?'slope n/a':`max slope ${Number(data.maxGrade).toFixed(1)}%`;$('routeStats').innerHTML=`<span class="stat">${Number(data.distanceKm).toFixed(2)} km</span><span class="stat">${slope}</span>`;renderProfiles(data);$('status').textContent=data.note||(loaded?'GPX loaded.':'Route ready.');busy=false;$('generateBtn').disabled=false;if(loaded){baseRoute=data;setMode('navigate');$('loadedRouteStatus').textContent=`Loaded GPX: ${Number(data.distanceKm).toFixed(2)} km${hasEle?' • slope colors active':' • no elevation data'}`;setTimeout(()=>{map.invalidateSize();const b=groupBounds(mainRouteGroup);if(b)fitBoundsSafe(b);},180);}}
window.ndRouteReady=function(data){baseRoute=null;displayRoute(data,false);};
window.ndLoadedGpx=function(data){displayRoute(data,true);};
window.ndRouteFailed=function(msg){busy=false;$('generateBtn').disabled=false;$('status').textContent='Route error: '+msg;$('loadedRouteStatus').textContent='GPX error: '+msg;};

function nearestBaseIndex(pos){if(!baseRoute?.points?.length||!pos)return -1;let best=-1,bestD=Infinity;baseRoute.points.forEach((p,i)=>{const d=hav([pos.lat,pos.lon],[Number(p[0]),Number(p[1])]);if(d<bestD){bestD=d;best=i;}});return best;}
function advancedBaseIndex(from,minMeters){if(!baseRoute?.points?.length||from<0)return -1;let d=0;for(let i=from+1;i<baseRoute.points.length;i++){d+=hav([Number(baseRoute.points[i-1][0]),Number(baseRoute.points[i-1][1])],[Number(baseRoute.points[i][0]),Number(baseRoute.points[i][1])]);if(d>=minMeters)return i;}return baseRoute.points.length-1;}
function chooseRejoinPoint(){if(!baseRoute?.points?.length||!currentPosition)return null;const nearest=nearestBaseIndex(currentPosition);if(nearest<0)return null;const minIdx=advancedBaseIndex(nearest,500);if(minIdx<0)return null;const target=navStops.length?navStops[navStops.length-1]:currentPosition;let best=minIdx,bestD=Infinity;for(let i=minIdx;i<baseRoute.points.length;i++){const p=baseRoute.points[i];const d=hav([target.lat,target.lon],[Number(p[0]),Number(p[1])]);if(d<bestD){bestD=d;best=i;}}const p=baseRoute.points[best];return {lat:Number(p[0]),lon:Number(p[1]),index:best,distanceM:bestD};}
function buildNavigationRoute(){if(navBusy)return;if(!currentPosition){$('navStatus').textContent='No current GPS position yet.';Android.requestCurrentPosition();return;}const routePoints=navStops.map(w=>({lat:w.lat,lon:w.lon,label:w.label}));let rejoin=null;if(baseRoute){rejoin=chooseRejoinPoint();if(rejoin)routePoints.push({lat:rejoin.lat,lon:rejoin.lon,label:'Rejoin GPX'});}else if(!routePoints.length){$('navStatus').textContent='Add at least one destination when no GPX is loaded.';return;}if(!routePoints.length){$('navStatus').textContent='Could not find a point ahead on the loaded GPX.';return;}if(rejoinMarker){map.removeLayer(rejoinMarker);rejoinMarker=null;}if(rejoin)rejoinMarker=L.circleMarker([rejoin.lat,rejoin.lon],{radius:8,color:'#111827',fillColor:'#fff',fillOpacity:1,weight:3,dashArray:'3 3'}).addTo(map).bindTooltip('Rejoin loaded GPX');const req={originLat:currentPosition.lat,originLon:currentPosition.lon,activity:$('navActivity').value,points:routePoints.map(p=>({lat:p.lat,lon:p.lon}))};Android.generateNavigationRoute(JSON.stringify(req));}
window.ndNavigationRouteReady=function(data){clearNavRoute();navRouteGroup=drawSlopeRoute(data,{weight:8,fallbackColor:'#7c3aed'});const b=groupBounds(navRouteGroup);if(b)fitBoundsSafe(b);const slope=data.maxGrade==null?'slope n/a':`max slope ${Number(data.maxGrade).toFixed(1)}%`;$('navRouteStats').innerHTML=`<span class="stat">${Number(data.distanceKm).toFixed(2)} km</span><span class="stat">${slope}</span>`;$('navStatus').textContent=data.note||'Navigation route ready.';navBusy=false;$('navRouteBtn').disabled=false;};
window.ndNavigationRouteFailed=function(msg){navBusy=false;$('navRouteBtn').disabled=false;$('navStatus').textContent='Navigation error: '+msg;};

function changeGpsSource(){const source=$('gpsSource').value;currentPosition=null;$('positionStatus').textContent=source==='garmin'?'Waiting for Fenix 8 GPS…':'Waiting for phone GPS…';$('liveBadge').textContent='GPS: waiting…';Android.setLocationSource(source);}
function positionIcon(heading){const h=Number.isFinite(Number(heading))?Number(heading):0;return L.divIcon({className:'ndPositionIcon',html:`<div class="positionArrow"><div class="positionArrowInner" style="transform:rotate(${h.toFixed(1)}deg)"></div></div>`,iconSize:[34,34],iconAnchor:[17,17]});}
window.ndPositionUpdate=function(p){const lat=Number(p.lat),lon=Number(p.lon);if(!validLatLon(lat,lon))return;currentPosition={source:p.source||'phone',lat,lon,heading:Number(p.heading),accuracy:Number(p.accuracy),speed:Number(p.speed),time:Number(p.time)};if(positionMarker){positionMarker.setLatLng([lat,lon]);positionMarker.setIcon(positionIcon(currentPosition.heading));}else positionMarker=L.marker([lat,lon],{icon:positionIcon(currentPosition.heading),zIndexOffset:1500,interactive:false}).addTo(map);if(Number.isFinite(currentPosition.accuracy)&&currentPosition.accuracy>0&&currentPosition.accuracy<1000){if(accuracyCircle)accuracyCircle.setLatLng([lat,lon]).setRadius(currentPosition.accuracy);else accuracyCircle=L.circle([lat,lon],{radius:currentPosition.accuracy,color:'#1769d2',weight:1,fillColor:'#1769d2',fillOpacity:.08,interactive:false}).addTo(map);}const hdg=Number.isFinite(currentPosition.heading)?`${Math.round((currentPosition.heading+360)%360)}°`:'heading —';const sp=Number.isFinite(currentPosition.speed)?`${(currentPosition.speed*3.6).toFixed(1)} km/h`:'speed —';const src=currentPosition.source==='garmin'?'Fenix 8':'Phone';$('positionStatus').textContent=`${src}: ${lat.toFixed(6)}, ${lon.toFixed(6)} • ${hdg} • ${sp}`;$('liveBadge').textContent=`${src} • ${hdg} • ${sp}`;if(followPosition&&!programmaticMove){programmaticMove=true;map.panTo([lat,lon],{animate:true,duration:.25});setTimeout(()=>programmaticMove=false,350);}};
window.ndPositionWaiting=function(source){$('positionStatus').textContent=source==='garmin'?'Waiting for Fenix 8 GPS. Start an activity with ND Route Target.':'Waiting for phone GPS permission/fix.';$('liveBadge').textContent='GPS: waiting…';};
function recenter(){followPosition=true;if(currentPosition){programmaticMove=true;map.setView([currentPosition.lat,currentPosition.lon],Math.max(map.getZoom(),16),{animate:true});setTimeout(()=>programmaticMove=false,250);}else Android.requestCurrentPosition();}

function fitVisible(){const bounds=L.latLngBounds([]);if(mainRouteGroup){const b=groupBounds(mainRouteGroup);if(b)bounds.extend(b);}if(navRouteGroup){const b=groupBounds(navRouteGroup);if(b)bounds.extend(b);}if(currentPosition)bounds.extend([currentPosition.lat,currentPosition.lon]);navStops.forEach(w=>bounds.extend([w.lat,w.lon]));waypoints.forEach(w=>bounds.extend([w.lat,w.lon]));if(bounds.isValid())fitBoundsSafe(bounds);}

function drawProfile(svgId,values,minY,maxY){const svg=$(svgId);svg.innerHTML='';if(!values.length||!Number.isFinite(minY)||!Number.isFinite(maxY))return;if(Math.abs(maxY-minY)<1e-6)maxY=minY+1;const W=360,H=96,pad=7,maxX=values[values.length-1][0]||1;const pts=values.map(v=>`${(pad+(W-2*pad)*(v[0]/maxX)).toFixed(1)},${(pad+(H-2*pad)*(1-(v[1]-minY)/(maxY-minY))).toFixed(1)}`).join(' ');svg.innerHTML=`<line x1="${pad}" y1="${H-pad}" x2="${W-pad}" y2="${H-pad}" stroke="#ccd5e0" stroke-width="1"/><polyline fill="none" stroke="#2463a7" stroke-width="2.2" vector-effect="non-scaling-stroke" points="${pts}"/>`;}
function renderProfiles(data){const pts=(data.points||[]);const hasEle=routeHasElevation(pts.map(p=>[Number(p[0]),Number(p[1]),p.length>2?Number(p[2]):NaN]));const section=$('profilesSection');if(!hasEle){section.style.display='none';return;}let d=0;const elev=[[0,Number(pts[0][2])]],slopes=[];for(let i=1;i<pts.length;i++){const seg=hav(pts[i-1],pts[i]);d+=seg;const e=Number(pts[i][2]);elev.push([d,e]);if(seg>=2)slopes.push([d,100*(e-Number(pts[i-1][2]))/seg]);}const es=elev.map(v=>v[1]),svals=slopes.map(v=>v[1]).filter(Number.isFinite),emin=Math.min(...es),emax=Math.max(...es);let absSlope=svals.length?Math.max(...svals.map(Math.abs)):0;absSlope=Math.max(5,Math.min(absSlope,40));drawProfile('elevationProfile',elev,emin,emax);drawProfile('slopeProfile',slopes,-absSlope,absSlope);$('elevationMeta').textContent=`${emin.toFixed(0)}–${emax.toFixed(0)} m • ${(d/1000).toFixed(2)} km`;$('slopeMeta').textContent=data.maxGrade==null?'Slope profile from GPX points':`Smoothed max slope: ${Number(data.maxGrade).toFixed(1)}%`;section.style.display='block';}

function sendToCurrentActivity(){Android.sendPointToCurrentActivity(start.lat,start.lon,'ND start');}
function openNativeNavigation(){Android.openPointOnGarmin(start.lat,start.lon,'ND start');}
function sendRoute(){if(!currentRoute&&!baseRoute){$('garminStatus').textContent='Garmin: generate or load a route first.';return;}Android.sendRouteToGarminConnect();}
window.ndGarminStatus=function(text){$('garminStatus').textContent=text;};
window.addEventListener('load',init);window.addEventListener('resize',()=>setTimeout(()=>map&&map.invalidateSize(),80));
</script>
</body>
</html>
